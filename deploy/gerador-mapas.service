[Unit]
Description=Gerador de Mapas GeoPac
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/Gerador-de-Mapas-GeoPac
Environment=PORT=80
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart=/var/www/Gerador-de-Mapas-GeoPac/.venv/bin/gunicorn --workers 2 --timeout 600 --graceful-timeout 60 --bind 0.0.0.0:80 wsgi:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
